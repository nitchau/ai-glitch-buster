# ReachyCare API keys - copy to .env and fill in what you have.
# Everything is optional: the app degrades gracefully when a key is missing.

# --- LLM (conversation brain). Provide one of these. ---
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# Which providers to prefer: "anthropic" | "openai" (LLM), "openai" | "local" (STT/TTS)
REACHY_CARE_LLM_PROVIDER=anthropic
REACHY_CARE_STT_PROVIDER=openai
REACHY_CARE_TTS_PROVIDER=openai

# --- Emergency alerts via Twilio (SMS + phone call to the caregiver) ---
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# --- Nutrition lookups (free key: https://fdc.nal.usda.gov/api-key-signup.html) ---
USDA_API_KEY=

# --- App behaviour ---
# Demo/simulation mode: emergency alerts are simulated (logged + dashboard banner),
# no real SMS/call is sent. ALWAYS keep true for development and judging demos.
REACHY_CARE_DEMO_MODE=true

# Where ReachyCare stores its SQLite database and config.yaml
# (defaults to the app instance folder on the robot, or ./data when run by hand)
REACHY_CARE_DATA_DIR=

# Run without a robot (console mode): type instead of talking, replies are printed.
# Handy on a laptop when the robot or simulator is busy.
REACHY_CARE_CONSOLE=false
